  "8": {
    "class_type": "MiniMaxH3MemoryEfficientSolAttentionPatch",
    "_meta": {
      "title": "Sol-Attn OFF: exact Sage 2.2 attention everywhere (max quality)",
      "pack": "Saganaki22/ComfyUI-sol-attn",
      "note": "triton-ref pack (class has no kernel combo). Task 9 must clone Saganaki22/ComfyUI-sol-attn, not the KingGore fork.",
      "dense_blocks_note": "Keep blocks 0-2 and the last block dense (Sage 2.2 fallback). Sol-Attn README: 'First and last blocks are the most approximation-sensitive'; LightX2V's H3 Sol config keeps layer 0 dense.",
      "max_quality_note": "Sol-Attn is approximate sparse attention. This graph trades ~1.4x attention time for exact attention. Node kept (enabled=false) so the lock test and A/B toggling still work."
    },
    "inputs": {
      "model": [
        "7",
        0
      ],
      "enabled": false,
      "tau": 1.3,
      "min_tokens": 4096,
      "strict": false,
      "thresh_type": "diag",
      "int8_qk": false,
      "int8_pv": false,
      "sink_conditioning": "exact_kv",
      "dense_blocks": "0-2,-1"
    }
  },
