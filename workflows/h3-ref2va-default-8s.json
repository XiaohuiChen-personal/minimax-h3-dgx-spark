{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Ref2VA DiT (D-15 FP8)"
    },
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Qwen3-VL TE (D-02 INT8)"
    },
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load video VAE fp16"
    },
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load audio VAE fp32"
    },
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Comfy-Org Ref2V Turbo 4-step LoRA"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "6": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "ModelSamplingAV"
    },
    "inputs": {
      "model": [
        "5",
        0
      ],
      "shift_video": 6.0,
      "shift_audio": 3.0
    }
  },
  "7": {
    "class_type": "PathchSageAttentionKJ",
    "_meta": {
      "title": "SageAttention 2.2 model patch",
      "task9_clone": "ComfyUI-KJNodes",
      "note": "Task 9 must clone kijai/ComfyUI-KJNodes. Locked combo is Sage 2.x sageattn_qk_int8_pv_fp16_triton, not sageattn3. Do not use --use-sage-attention."
    },
    "inputs": {
      "model": [
        "6",
        0
      ],
      "sage_attention": "sageattn_qk_int8_pv_fp16_triton",
      "allow_compile": false
    }
  },
  "8": {
    "class_type": "MiniMaxH3MemoryEfficientSolAttentionPatch",
    "_meta": {
      "title": "Sol-Attn kernel triton_ref",
      "pack": "Saganaki22/ComfyUI-sol-attn",
      "note": "triton-ref pack (class has no kernel combo). Task 9 must clone Saganaki22/ComfyUI-sol-attn, not the KingGore fork."
    },
    "inputs": {
      "model": [
        "7",
        0
      ],
      "enabled": true,
      "tau": 1.3,
      "min_tokens": 4096,
      "strict": false,
      "thresh_type": "diag",
      "int8_qk": false,
      "int8_pv": false,
      "sink_conditioning": "exact_kv",
      "dense_blocks": ""
    }
  },
  "9": {
    "class_type": "ApplyMiniMaxH3FirstBlockCache",
    "_meta": {
      "title": "FirstBlockCache H3 Safe"
    },
    "inputs": {
      "model": [
        "8",
        0
      ],
      "mode": "H3 Safe — 0.08 / max 2",
      "threshold": 0.08,
      "start_percent": 0.1,
      "end_percent": 0.95,
      "max_consecutive_hits": 2,
      "temporal_guard": false
    }
  },
  "10": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": {
      "title": "Ref2VA condition + AV latent"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "audio_vae": [
        "4",
        0
      ],
      "prompt": "<Picture 1> <Picture 2> <Picture 3> are front, side, and back stills of the blue monk parakeet. <Picture 4> <Picture 5> <Picture 6> are front, side, and back stills of the yellow monk parakeet. Printed Front/Side/Back words are captions, not plumage. A quiet scene. No speech.",
      "width": 960,
      "height": 544,
      "length": 192,
      "ref_image_size": "match"
    }
  },
